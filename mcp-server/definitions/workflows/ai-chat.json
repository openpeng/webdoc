[
  {
    "id": "preset-chatglm-ask",
    "name": "智谱清言提问",
    "goal": "向智谱清言提问 {{prompt}} 并等待回答",
    "createdAt": "2026-07-29T00:00:00.000Z",
    "domains": ["chatglm.cn"],
    "plan": {
      "name": "智谱清言提问",
      "currentStep": 0,
      "steps": [
        {
          "id": "open-chat",
          "objective": "打开对话页面",
          "action": { "action": "navigate", "url": "https://chatglm.cn/main/alltoolsdetail" },
          "verification": { "kind": "locator_visible", "selector": "textarea" }
        },
        {
          "id": "type-prompt",
          "objective": "在输入框中填入提问",
          "action": { "action": "type", "selector": "textarea", "text": "{{prompt}}" },
          "verification": { "kind": "locator_visible", "selector": ".enter_icon, .input-box-inner .enter, button[type=\"submit\"]" }
        },
        {
          "id": "send",
          "objective": "点击发送",
          "action": { "action": "click", "selector": ".enter_icon, .input-box-inner .enter, button[type=\"submit\"]" },
          "verification": { "kind": "locator_visible", "selector": "textarea" }
        },
        {
          "id": "wait-response",
          "objective": "等待回答开始渲染",
          "action": { "action": "wait", "selector": ".markdown-body, .answer-content-wrap", "state": "visible" },
          "verification": { "kind": "locator_visible", "selector": ".markdown-body, .answer-content-wrap" }
        }
      ]
    }
  },
