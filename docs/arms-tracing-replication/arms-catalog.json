{
  "version": 1,
  "site": {
    "name": "阿里云应用实时监控服务（ARMS）应用监控控制台",
    "pageUrl": "https://armsnext.console.aliyun.com/tracing#/tracing/cn-hangzhou?appId=<appId>&tab=appOverview&source=TRACE&language=java",
    "pageOrigin": "armsnext.console.aliyun.com",
    "apiHosts": [
      "fecs.console.aliyun.com"
    ],
    "region": "cn-hangzhou",
    "regionNote": "fecs 主机名按地域后缀切换：cn-* → fecs.console.aliyun.com；海外地域 → fecs.console.aliyuncs.com"
  },
  "transport": {
    "kind": "rpc-gateway",
    "product": "arms",
    "endpoint": "/data/api.json",
    "method": "POST",
    "contentType": "application/x-www-form-urlencoded",
    "body": "product=arms&action=<ActionName>&region=<RegionId>&params=<URL编码的 JSON 字符串>",
    "batch": {
      "endpoint": "/data/v2/multiApi.json",
      "query": "<Action1>~<Action2>~...",
      "body": "product=arms&actions=[{\"action\":\"...\",\"params\":{...}}, ...]",
      "responseIndex": "data 以 \"0\",\"1\",\"2\" 为键，每项含 success / code / data"
    },
    "auth": {
      "required": [
        "Cookie: login_aliyunid_ticket (+ login_aliyunid_sc / login_aliyunid / login_aliyunid_pk / login_current_pk)",
        "Origin: https://armsnext.console.aliyun.com",
        "Referer: https://armsnext.console.aliyun.com/tracing"
      ],
      "abMatrix": {
        "A_无cookie无origin": "code=403 Forbidden",
        "B_无cookie有origin": "code=ConsoleNeedLogin",
        "C_有cookie无origin": "code=403 Forbidden",
        "D_有cookie有origin": "code=200"
      },
      "conclusion": "Cookie 与 Origin/Referer 缺一不可；两者都齐才返回业务数据",
      "sameSiteNote": "login_aliyunid_ticket 的 SameSite=Lax —— 浏览器扩展后台发起的跨站 fetch 带不上它，因此「扩展上下文执行」这条路对 ARMS 必然失败",
      "excluded": [
        "armsnext.console.aliyun.com / fecs.console.aliyun.com 上带 _fetcher_ 的控制台壳 API（需要 collina 反爬签名）"
      ]
    },
    "response": {
      "envelope": "{requestId, code, message, httpStatusCode, data, successResponse, ...}",
      "successRule": "code === \"200\"（字符串）；非 200 时 message 给出原因，如 ParameterMissing / ConsoleNeedLogin / InvalidAction.NotFound",
      "doubleEncodedFields": [
        "data.Data"
      ]
    },
    "endpointTypes": {
      "OPEN": "/data/api.json",
      "INNER": "/data/innerApi.json",
      "CONTAINER": "/data/call.json",
      "HTTP": "/data/httpApi.json",
      "CUSTOM": "/data/custom.json",
      "OPEN_MULTI": "/data/v2/multiApi.json",
      "OPEN_MULTI_LEGACY": "/data/multiApi.json"
    }
  },
  "resources": [
    {
      "id": "应用与配置",
      "description": "应用元信息、模块开关与探针配置"
    },
    {
      "id": "拓扑与聚合指标",
      "description": "调用链拓扑、慢接口统计、指标聚合"
    },
    {
      "id": "调用链 Trace",
      "description": "链路列表、链路详情、调用栈"
    },
    {
      "id": "实例与探针",
      "description": "应用实例、探针版本与运行时长"
    },
    {
      "id": "告警与事件",
      "description": "告警事件列表与链路追踪开关状态"
    },
    {
      "id": "标签与资源组",
      "description": "实例标签、资源组（多属 ResourceManager / tag 产品）"
    },
    {
      "id": "数据源与 SLS",
      "description": "SLS 数据源位置、自定义数据源字段"
    },
    {
      "id": "商业化与配额",
      "description": "商业化状态、SLR、配额"
    },
    {
      "id": "性能剖析与调试数据",
      "description": "Profiling、错误/提取记录、堆转储、热点分析"
    },
    {
      "id": "XTrace（新版链路追踪）",
      "description": "XTrace 应用与升级"
    },
    {
      "id": "用户与通用",
      "description": "当前用户、白名单、渠道链接"
    }
  ],
